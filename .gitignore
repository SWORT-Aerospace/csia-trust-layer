.venv/
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/

# Build outputs (python -m build)
/dist/
/build/

# Scratch corpora at the repository ROOT only. This rule MUST stay anchored:
# an unanchored "data/" also matched csia/data/, which silently excluded the
# entire data-lake package from the repository (see tests/test_ci_env.py).
/data/
!/data/real_logs_report.json

# Repository-local data-root fallback (tests and fixtures only; real
# acquisition is refused here — see csia/data/paths.py).
/.csia-data/

csia/native/*.dylib
csia/native/*.so

# SITL scratch working directories from research/phase2 campaigns
research/phase2/results/_wd_*/

# Three PX4 boots' worth of console logs and parameter files (~28 MB) from
# tools/simulation/px4_link_rate_probe.py. The MEASUREMENT is the artifact
# (research/v1_1/results/PX4_LINK_RATE_PROBE.json); this is the boot litter,
# and re-running the probe regenerates it.
research/v1_1/results/.px4_link_probe/

# P1 per-tick residual streams: regenerable by re-running p1_fault_suite.py,
# several MB each, and not the scientific record (the analyses are).
research/phase2/results/p1_streams_*.json

# --- LaTeX auxiliaries and paper build outputs -----------------------------
# `make paper-*` writes to build/papers/, already covered by /build/ above.
# These catch a stray in-tree pdflatex run inside a paper directory. Generated
# PDFs are never committed: a committed PDF drifts from its source silently.
papers/**/*.aux
papers/**/*.bbl
papers/**/*.blg
papers/**/*.fdb_latexmk
papers/**/*.fls
papers/**/*.lof
papers/**/*.log
papers/**/*.lot
papers/**/*.out
papers/**/*.synctex.gz
papers/**/*.toc
papers/**/main.pdf

# --- editor and OS junk ----------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Public archives are build products of tools/publication/build_public_release.py,
# packed from the allowlist in PUBLIC_RELEASE_MANIFEST.yaml. The SOURCES are
# committed — evidence_export/ is the deliverable, and every other member is a
# tracked artifact — so the archives are reproducible byte-for-byte and a
# committed copy could only drift from its own inputs. Rebuild with
# `make public-release`; the manifest and the build log carry the SHA-256.
publication/system_paper_i/PAPER1_EVIDENCE_EXPORT.tar.gz
publication/system_paper_i/PAPER1_SANITIZED_PACKAGE.tar.gz

# Shadow/advisory flight logs are per-run artifacts, like the archives above:
# one JSONL file per flight, rotated and gzipped, written by
# csia.deploy.flight_log. They are EVIDENCE from a specific run, not source --
# a committed one would be a snapshot of a container that no longer exists.
# Keep the ones that matter by archiving them deliberately, not by default.
logs/

# Two SITL boots per platform from research/maer/maer_raw_gnss_probe.py. The
# MEASUREMENT is raw_gnss_probe_<platform>.json; this is the boot litter.
research/maer/.raw_probe/

# SITL boots from research/maer/maer_jam_qualification.py; the MEASUREMENT is
# MAER_ARDUPILOT_JAM_RAW/.
research/maer/.jam_probe/
