# Copy to .env for local overrides. Never commit a real .env.
# Every value below is a placeholder.

# --- Core -------------------------------------------------------------------
DJANGO_DEBUG=true
# Required whenever DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host) allowed to POST, e.g. https://staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ---------------------------------------------------------------
# Leave unset for local SQLite (db.sqlite3). Hosted pilot uses PostgreSQL:
# DATABASE_URL=postgres://dispatch_user:change-me@db-host:5432/dispatch

# --- Shared rate limits (required when DJANGO_DEBUG=false) ---------------------
# DISPATCH_REDIS_URL=redis://127.0.0.1:6379/0
# DISPATCH_TRUSTED_PROXY_COUNT=0
# DISPATCH_PAIR_ATTEMPT_LIMIT=10
# DISPATCH_DEMO_PER_CLIENT_LIMIT=30
# DISPATCH_DEMO_GLOBAL_LIMIT=600
# DISPATCH_HEALTH_TOKEN=

# --- Product switches -------------------------------------------------------
# Isolated per-visitor demo sandboxes (sample data only, random accounts, no shared passwords).
DISPATCH_DEMO_ENABLED=true
# Allow password sign-in for the *seeded* demo accounts (seed_demo). Must be false in any public deployment.
DISPATCH_ALLOW_DEMO_LOGINS=true
# Shared password used by `manage.py seed_demo` for local demo staff accounts (local only).
DISPATCH_DEMO_STAFF_PASSWORD=change-me-local-only
# Let anyone create a restaurant through /setup/. Set false for an invite-only pilot.
DISPATCH_SETUP_OPEN=true
# Default time zone for new locations.
DISPATCH_DEFAULT_TIME_ZONE=America/New_York

# --- HTTPS (hosted only) ----------------------------------------------------
DISPATCH_SECURE_SSL_REDIRECT=false
DISPATCH_HSTS_SECONDS=0

# --- POS integrations (not connected in this release) ------------------------
# Toast / Square read-only adapters are planned and will start in shadow mode.
# No credentials are needed or read by this release.
# TOAST_CLIENT_ID=
# TOAST_CLIENT_SECRET=
# SQUARE_ACCESS_TOKEN=
