# Staging / hosted-pilot environment. Copy to deploy/staging.env and fill in.
# Never commit the filled-in file. All values below are placeholders.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-50-plus-random-characters
DJANGO_ALLOWED_HOSTS=staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.com
DATABASE_URL=postgres://dispatch:replace-me@db:5432/dispatch
# Required when DJANGO_DEBUG=false: shared, atomic pairing and demo-start limits.
DISPATCH_REDIS_URL=redis://redis:6379/0
# Reverse proxies in front of the app that append X-Forwarded-For (1 for one load balancer).
DISPATCH_TRUSTED_PROXY_COUNT=1
# Bearer token for GET /healthz/worker (uptime monitor). Generate a long random value.
DISPATCH_HEALTH_TOKEN=replace-with-a-long-random-token

# Public deployments: seeded known-password demo accounts must stay off.
DISPATCH_ALLOW_DEMO_LOGINS=false
# Isolated per-visitor demo sandboxes (random accounts, sample data, auto-deleted).
DISPATCH_DEMO_ENABLED=true
DISPATCH_DEMO_TTL_HOURS=6
# Invite-only pilot: you create the manager accounts; no open sign-up.
DISPATCH_SETUP_OPEN=false
DISPATCH_DEFAULT_TIME_ZONE=America/New_York

# Behind an HTTPS-terminating proxy or load balancer:
DISPATCH_SECURE_SSL_REDIRECT=true
DISPATCH_HSTS_SECONDS=3600

# Used only by the bundled Postgres service in docker-compose.staging.yml
POSTGRES_DB=dispatch
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=replace-me
