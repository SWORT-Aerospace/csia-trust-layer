From 4c34870e9a7fbb6f72db7e8aa27f68771c63f22d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 26 Sep 2026 03:06:38 +0000
Subject: [PATCH] feat(simulator_sih): add per-motor physical actuator
 effectiveness SIH_MOT_EFF1-4

Research parameters for the quadcopter model. Each scales its rotor speed
target before the thruster time constant, so the rotor cannot reach the
commanded speed while the actuator command stays untouched. Default 1.0
leaves the model unchanged.
---
 src/modules/simulation/simulator_sih/sih.cpp  | 12 ++++
 src/modules/simulation/simulator_sih/sih.hpp  |  6 ++
 .../simulation/simulator_sih/sih_params.yaml  | 56 +++++++++++++++++++
 3 files changed, 74 insertions(+)

diff --git a/src/modules/simulation/simulator_sih/sih.cpp b/src/modules/simulation/simulator_sih/sih.cpp
index 35f1853..1372ac1 100644
--- a/src/modules/simulation/simulator_sih/sih.cpp
+++ b/src/modules/simulation/simulator_sih/sih.cpp
@@ -355,6 +355,11 @@ void Sih::parameters_updated()
 
 	_T_TAU = _sih_thrust_tau.get();
 
+	_mot_eff[0] = math::constrain(_sih_mot_eff1.get(), 0.f, 1.f);
+	_mot_eff[1] = math::constrain(_sih_mot_eff2.get(), 0.f, 1.f);
+	_mot_eff[2] = math::constrain(_sih_mot_eff3.get(), 0.f, 1.f);
+	_mot_eff[3] = math::constrain(_sih_mot_eff4.get(), 0.f, 1.f);
+
 	_v_wind_N = Vector3f(_sih_wind_n.get(), _sih_wind_e.get(), 0.f);
 }
 
@@ -371,6 +376,13 @@ void Sih::read_motors(const float dt)
 
 			} else {
 				float u_sp = actuators_out.output[i];
+
+				// Physical actuator effectiveness (SIH_MOT_EFFn): scales the rotor target before the lag,
+				// so the rotor cannot reach the commanded speed. The received command is not modified.
+				if (_vehicle == VehicleType::Quadcopter && i < NUM_MOT_EFF) {
+					u_sp *= _mot_eff[i];
+				}
+
 				_u[i] = _u[i] + dt / _T_TAU * (u_sp - _u[i]); // first order transfer function with time constant tau
 			}
 		}
diff --git a/src/modules/simulation/simulator_sih/sih.hpp b/src/modules/simulation/simulator_sih/sih.hpp
index 9aced74..5dfef88 100644
--- a/src/modules/simulation/simulator_sih/sih.hpp
+++ b/src/modules/simulation/simulator_sih/sih.hpp
@@ -155,6 +155,7 @@ private:
 	// hard constants
 	static constexpr uint16_t NUM_ACTUATORS_MAX = 9;
 	static constexpr uint16_t NUM_DYN_THRUSTER = 2;		// number of dynamic thruster model with advance ratio
+	static constexpr uint16_t NUM_MOT_EFF = 4;		// number of motors with a physical effectiveness parameter (SIH_MOT_EFFn)
 
 	// Ranging beacon simulation constants
 	static constexpr uint8_t NUM_RANGING_BEACONS = 4;
@@ -264,6 +265,7 @@ private:
 	matrix::Vector3f _lpos{};  // position in a local tangent-plane frame [m]
 
 	float _u[NUM_ACTUATORS_MAX] {}; // thruster signals
+	float _mot_eff[NUM_MOT_EFF] {1.f, 1.f, 1.f, 1.f}; // physical actuator effectiveness per motor, [0, 1]
 	float       _T[NUM_DYN_THRUSTER] {};         // thruster forces (N)
 	float       _Q[NUM_DYN_THRUSTER] {};         // thruster torque (Nm)
 	Thruster    _thruster[NUM_DYN_THRUSTER] {};	// thruster objects
@@ -339,6 +341,10 @@ private:
 		(ParamFloat<px4::params::SIH_DISTSNSR_MAX>) _sih_distance_snsr_max,
 		(ParamFloat<px4::params::SIH_DISTSNSR_OVR>) _sih_distance_snsr_override,
 		(ParamFloat<px4::params::SIH_T_TAU>) _sih_thrust_tau,
+		(ParamFloat<px4::params::SIH_MOT_EFF1>) _sih_mot_eff1,
+		(ParamFloat<px4::params::SIH_MOT_EFF2>) _sih_mot_eff2,
+		(ParamFloat<px4::params::SIH_MOT_EFF3>) _sih_mot_eff3,
+		(ParamFloat<px4::params::SIH_MOT_EFF4>) _sih_mot_eff4,
 		// forward propeller
 		(ParamFloat<px4::params::SIH_F_T_MAX>) _sih_f_thrust_max,
 		(ParamFloat<px4::params::SIH_F_Q_MAX>) _sih_f_torque_max,
diff --git a/src/modules/simulation/simulator_sih/sih_params.yaml b/src/modules/simulation/simulator_sih/sih_params.yaml
index 716e210..8de254f 100644
--- a/src/modules/simulation/simulator_sih/sih_params.yaml
+++ b/src/modules/simulation/simulator_sih/sih_params.yaml
@@ -262,6 +262,62 @@ parameters:
       type: float
       default: 0.05
       unit: s
+    SIH_MOT_EFF1:
+      description:
+        short: Physical effectiveness of multicopter motor 1
+        long: |-
+          Research parameter. Scales the rotor speed target of motor 1 before the
+          thruster time constant, so the rotor cannot reach the commanded speed.
+          The actuator command is not modified. 1 is nominal, 0 is a rotor that
+          produces no thrust. Quadcopter only.
+      type: float
+      default: 1.0
+      min: 0.0
+      max: 1.0
+      decimal: 2
+      increment: 0.05
+    SIH_MOT_EFF2:
+      description:
+        short: Physical effectiveness of multicopter motor 2
+        long: |-
+          Research parameter. Scales the rotor speed target of motor 2 before the
+          thruster time constant, so the rotor cannot reach the commanded speed.
+          The actuator command is not modified. 1 is nominal, 0 is a rotor that
+          produces no thrust. Quadcopter only.
+      type: float
+      default: 1.0
+      min: 0.0
+      max: 1.0
+      decimal: 2
+      increment: 0.05
+    SIH_MOT_EFF3:
+      description:
+        short: Physical effectiveness of multicopter motor 3
+        long: |-
+          Research parameter. Scales the rotor speed target of motor 3 before the
+          thruster time constant, so the rotor cannot reach the commanded speed.
+          The actuator command is not modified. 1 is nominal, 0 is a rotor that
+          produces no thrust. Quadcopter only.
+      type: float
+      default: 1.0
+      min: 0.0
+      max: 1.0
+      decimal: 2
+      increment: 0.05
+    SIH_MOT_EFF4:
+      description:
+        short: Physical effectiveness of multicopter motor 4
+        long: |-
+          Research parameter. Scales the rotor speed target of motor 4 before the
+          thruster time constant, so the rotor cannot reach the commanded speed.
+          The actuator command is not modified. 1 is nominal, 0 is a rotor that
+          produces no thrust. Quadcopter only.
+      type: float
+      default: 1.0
+      min: 0.0
+      max: 1.0
+      decimal: 2
+      increment: 0.05
     SIH_VEHICLE_TYPE:
       description:
         short: Vehicle type
-- 
